# Copy this file to livenote-local.env once, then fill in the three values.
LIVENOTE_SERVER_URL=https://your-domain.example/api/v1
# Worker 只需要 Worker Token；服务器 API Key 不需要复制到本机 Worker。
LIVENOTE_WORKER_TOKEN=copy-the-server-worker-token-here
LIVENOTE_WORKER_ID=local-pc
PYTHON=python
# Optional: polling and lease heartbeat intervals in seconds. Default: 300.
# LIVENOTE_WORKER_POLL_SECONDS=300
# LIVENOTE_CODEX_POLL_SECONDS=300
# LIVENOTE_WORKER_HEARTBEAT_SECONDS=300

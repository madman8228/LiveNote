# API server configuration. Export these variables in the service environment;
# the Python server intentionally does not load dotenv files automatically.
PORT=8000
LIVENOTE_ENV=production
LIVENOTE_CORS_ORIGINS=https://livenote.example.com
LIVENOTE_API_KEY=replace-with-a-long-random-value
# PC 管理页面登录账号。密码只用于登录，服务端不下发也不写入浏览器。
LIVENOTE_ADMIN_USERNAME=admin
LIVENOTE_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# 旧版共享密钥，仅用于迁移已有部署；新部署可以留空。
LIVENOTE_ADMIN_TOKEN=
LIVENOTE_ADMIN_SESSION_TTL_SECONDS=43200
LIVENOTE_WORKER_TOKEN=replace-with-a-separate-worker-token
# Local server mode writes claimed audio to the same PC's worker-inbox.
# Set 0 on a cloud server and use the PC browser Worker instead.
LIVENOTE_LOCAL_PULL_ENABLED=0
# Every mobile recording must be paired to an active user before upload.
LIVENOTE_REQUIRE_DEVICE_AUTH=1
LIVENOTE_MAX_CHUNK_BYTES=26214400
LIVENOTE_MAX_DIAGNOSTIC_BYTES=10485760
LIVENOTE_UPLOAD_DURATION_TOLERANCE_MS=15000
# Incremental recognition while a recording is still uploading. The first
# window is normally 4 x 30-second chunks; keep this between 2 and 4.
LIVENOTE_LIVE_PROCESSING_ENABLED=1
LIVENOTE_LIVE_WINDOW_CHUNKS=4
LIVENOTE_LIVE_WINDOW_OVERLAP_SECONDS=2
LIVENOTE_LIVE_POLL_SECONDS=2
LIVENOTE_LIVE_LEASE_SECONDS=120

# Use an absolute path for production data so deployments do not lose SQLite
# and audio files when the application directory is replaced.
LIVENOTE_DATA_DIR=D:\LiveNoteData\data
LIVENOTE_DB_PATH=D:\LiveNoteData\livenote.sqlite3

# Optional FFmpeg overrides when ffmpeg/ffprobe are not on PATH.
# LIVENOTE_FFMPEG=C:\Program Files\ffmpeg\bin\ffmpeg.exe
# LIVENOTE_FFPROBE=C:\Program Files\ffmpeg\bin\ffprobe.exe

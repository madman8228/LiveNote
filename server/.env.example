# API server configuration. Export these variables in the service environment;
# the Python server intentionally does not load dotenv files automatically.
PORT=8000
LIVENOTE_ENV=production
LIVENOTE_CORS_ORIGINS=https://livenote.example.com
LIVENOTE_API_KEY=replace-with-a-long-random-value
LIVENOTE_MAX_CHUNK_BYTES=26214400
LIVENOTE_MAX_DIAGNOSTIC_BYTES=10485760
LIVENOTE_UPLOAD_DURATION_TOLERANCE_MS=15000

# Use an absolute path for production data so deployments do not lose SQLite
# and audio files when the application directory is replaced.
LIVENOTE_DATA_DIR=D:\LiveNoteData\data
LIVENOTE_DB_PATH=D:\LiveNoteData\livenote.sqlite3

# Local Whisper configuration.
LIVENOTE_WHISPER_MODEL=medium
LIVENOTE_WHISPER_CACHE=C:\Users\Administrator\.cache\whisper
LIVENOTE_ASR_CHUNK_SECONDS=300
LIVENOTE_ASR_CHUNK_OVERLAP_SECONDS=1

# Long-form summary controls. Long transcripts are summarized in parts and
# merged, instead of silently truncating after the first part.
LIVENOTE_LLM_MAX_TRANSCRIPT_CHARS=120000
LIVENOTE_LLM_MAX_TIMELINE_SEGMENTS=1000
LIVENOTE_LLM_SUMMARY_CHUNK_CHARS=50000

# Optional FFmpeg overrides when ffmpeg/ffprobe are not on PATH.
# LIVENOTE_FFMPEG=C:\Program Files\ffmpeg\bin\ffmpeg.exe
# LIVENOTE_FFPROBE=C:\Program Files\ffmpeg\bin\ffprobe.exe

# Optional OpenAI-compatible content analysis service. API key is optional
# for local endpoints such as Ollama; remote providers normally require it.
# Leave BASE_URL and MODEL empty to keep the local marker/transcript draft.
# LIVENOTE_LLM_BASE_URL=https://api.example.com/v1
# LIVENOTE_LLM_API_KEY=replace-with-provider-key
# LIVENOTE_LLM_MODEL=your-model-name
# LIVENOTE_LLM_TIMEOUT_SECONDS=180
